# Frosted Fork Sweets production environment example
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_SITE_URL=https://www.frostedforksweets.com

# Stripe live keys, if checkout should charge cards.
# Keep real values out of Git.
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Future lower-priority option: Cloudflare Email Routing
# orders@frostedforksweets.com -> frostedforksweets@outlook.com
EMAIL_RELAY_PROVIDER=cloudflare-email-routing
ORDER_NOTIFICATION_TO=frostedforksweets@outlook.com
